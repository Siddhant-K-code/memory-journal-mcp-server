{
  "mcpServers": {
    "smart-photo-journal": {
      "command": "/absolute/path/to/uv",
      "args": [
        "--directory",
        "/Users/YOUR_USERNAME/Developer/memory-journal-mcp-server",
        "run",
        "--locked",
        "--no-dev",
        "server.py"
      ],
      "env": {
        "PHOTO_LIBRARY_PATH": "/Users/YOUR_USERNAME/Pictures/Photos Library.photoslibrary",
        "PHOTO_LOCATION_POLICY": "none",
        "PHOTO_ALLOWED_PERSON_NAMES": "[]"
      }
    }
  }
}
